# ==========================================
# 1. Project-Specific Data & Output
# ==========================================
# Ignore all data files inside the data directories
data/raw/*
data/processed/*
data/results/*

# (Optional) Keep the directory structure intact in git by allowing .gitkeep files
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/results/.gitkeep

# ==========================================
# 2. PyTorch & Model Checkpoints
# ==========================================
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx

# HuggingFace & vLLM local cache (if downloaded locally)
.cache/
huggingface/

# ==========================================
# 3. Python & Environment
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.env
.venv
conda-env/
miniconda3/

# ==========================================
# 4. Logs & Notebooks
# ==========================================
# Log files generated by your system
*.log

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# ==========================================
# 5. OS & IDE Hidden Files
# ==========================================
# VS Code / PyCharm / IntelliJ
.vscode/
.idea/

# Mac / Linux system files
.DS_Store
Thumbs.db
*~